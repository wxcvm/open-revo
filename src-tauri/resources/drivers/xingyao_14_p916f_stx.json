{
  "$schema": "https://openrevo.org/schemas/model-driver.v1.json",
  "id": "mechrevo_xingyao_14_p916f_stx",
  "name": "MECHREVO Xingyao 14 (AMD P916F-STX native WMI)",
  "version": "1.2.0",
  "author": "OpenRevo Core Team",
  "identity": {
    "form_factor": "thin_light",
    "ui_preset": "ultrabook_compact",
    "dmi_match": {
      "vendor": "MECHREVO",
      "board_products": [
        "XINGYAO Series-P916F-STX"
      ],
      "product_names": []
    }
  },
  "capabilities": {
    "discrete_gpu": false,
    "water_cooling": false,
    "fan_custom_curve": false,
    "battery_charge_limit": false,
    "power_modes": [
      "balance",
      "turbo"
    ],
    "power_mode_watts": {
      "balance": 15,
      "turbo": 28
    },
    "rgb_keyboard": {
      "supported": false,
      "type": "none",
      "hardware_autonomous": true,
      "hotkey_osd_only": true,
      "sleep_timeout_supported": true,
      "timeout_options_seconds": [
        0,
        10,
        15,
        20,
        30,
        45,
        60,
        120,
        300,
        600,
        1200,
        1800,
        3600,
        7200,
        10800
      ]
    },
    "osd_notifications": {
      "power_mode_switch": true,
      "backlight_level_change": true
    },
    "fan_control_mode": "none",
    "fan_boost_mode": "none",
    "fn_lock": true
  },
  "channels": {
    "wmi_mailbox": {
      "type": "wmi_mailbox",
      "namespace": "root\\wmi",
      "class_name": "OemWMIMethod",
      "method_name": "OemWMIfun",
      "fallback_classes": [
        "AcpiTest_WMI"
      ],
      "buffer_sizes": {
        "in": 64,
        "out": 256
      }
    }
  },
  "actions": {
    "read_fan_rpm": {
      "channel": "wmi_mailbox",
      "input": [
        2,
        1,
        0
      ],
      "parse": {
        "cpu_rpm": {
          "offset": 1,
          "type": "u16_le"
        }
      }
    },
    "get_power_mode": {
      "channel": "wmi_mailbox",
      "input": [
        3,
        9
      ],
      "parse": {
        "mode_code": {
          "offset": 1,
          "type": "u8"
        }
      },
      "mapping": {
        "1": "balance",
        "2": "turbo"
      }
    },
    "set_power_mode": {
      "balance": [
        3,
        10,
        1
      ],
      "turbo": [
        3,
        10,
        2
      ]
    }
  },
  "guardrails": {
    "safe_commands_only": true,
    "amd_turbo_charger_required_watts": 65,
    "pl1_watts_limit": {
      "min": 15,
      "max": 65
    }
  }
}
